# Jetson AGX Orin Dockerfile for FoundationPose_VCB
# Base: L4T R36.x / JetPack 6.x / Ubuntu 22.04
# Target: ROS2 Humble
#
# Build from project root:
#   docker build -f docker/dockerfile.ros2 -t foundationpose-jetson-yolo:ros2-humble .
#
# Build args:
#   CUDA_ARCH - CUDA compute capability, default 8.7 for Jetson AGX Orin

FROM nvcr.io/nvidia/l4t-jetpack:r36.4.0

ARG CUDA_ARCH=8.7

SHELL ["/bin/bash", "-c"]

ENV TZ=US/Pacific
ENV DEBIAN_FRONTEND=noninteractive
ENV TORCH_CUDA_ARCH_LIST="${CUDA_ARCH}"
ENV FORCE_CUDA=1
ENV MAX_JOBS=2
ENV OPENCV_IO_ENABLE_OPENEXR=1
ENV PYOPENGL_PLATFORM=egl
ENV SHELL=/bin/bash
ENV LD_PRELOAD=/lib/aarch64-linux-gnu/libGLdispatch.so.0

RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# Stage 1: System dependencies
RUN apt-get update --fix-missing && \
    apt-get install -y --no-install-recommends \
        build-essential cmake g++ gfortran checkinstall \
        libgtk2.0-dev libjpeg8-dev libtiff5-dev pkg-config yasm \
        libavcodec-dev libavformat-dev libswscale-dev \
        libv4l-dev \
        libtbb-dev libatlas-base-dev \
        libmp3lame-dev libtheora-dev libvorbis-dev libxvidcore-dev \
        libopencore-amrnb-dev libopencore-amrwb-dev x264 v4l-utils \
        libprotobuf-dev protobuf-compiler \
        libgoogle-glog-dev libgflags-dev libgphoto2-dev \
        libhdf5-dev libflann-dev libboost-all-dev \
        libyaml-cpp-dev \
        libzmq3-dev \
        freeglut3-dev \
        libproj-dev proj-data \
        wget bzip2 ca-certificates curl git vim tmux usbutils \
        doxygen cmake-curses-gui \
        python3-pip python3-dev python3-setuptools python3-wheel \
        libopenblas-dev && \
    rm -rf /var/lib/apt/lists/*

RUN ln -sf /bin/bash /bin/sh && \
    ln -sf /usr/bin/python3 /usr/bin/python

# Stage 2: Build Eigen 3.4.0 from source
RUN cd / && \
    wget https://gitlab.com/libeigen/eigen/-/archive/3.4.0/eigen-3.4.0.tar.gz && \
    tar xvzf eigen-3.4.0.tar.gz && \
    cd eigen-3.4.0 && \
    mkdir build && cd build && \
    cmake .. && \
    make install && \
    cd / && \
    rm -rf eigen-3.4.0 eigen-3.4.0.tar.gz

# Stage 3: Build pybind11 v2.10.0 from source
RUN cd / && \
    git clone https://github.com/pybind/pybind11 && \
    cd pybind11 && \
    git checkout v2.10.0 && \
    mkdir build && cd build && \
    cmake .. -DCMAKE_BUILD_TYPE=Release -DPYBIND11_INSTALL=ON -DPYBIND11_TEST=OFF && \
    make -j$(nproc) && \
    make install && \
    cd / && \
    rm -rf pybind11

# h5py: use serial HDF5 to avoid MPI header dependency
RUN apt-get update && \
    apt-get install -y --no-install-recommends libhdf5-serial-dev && \
    rm -rf /var/lib/apt/lists/*
ENV HDF5_DIR=/usr/lib/aarch64-linux-gnu/hdf5/serial

# Stage 4: Install Jetson-compatible PyTorch for JetPack 6.x
# l4t-jetpack does not include PyTorch by default.
RUN cd /tmp && \
    wget https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2204/arm64/cuda-keyring_1.1-1_all.deb && \
    dpkg -i cuda-keyring_1.1-1_all.deb && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        libcusparselt0 \
        libcusparselt-dev && \
    rm -rf /var/lib/apt/lists/* && \
    rm -f /tmp/cuda-keyring_1.1-1_all.deb

RUN pip3 install --no-cache-dir numpy==1.26.1 && \
    cd /tmp && \
    wget https://developer.download.nvidia.com/compute/redist/jp/v61/pytorch/torch-2.5.0a0+872d972e41.nv24.08.17622132-cp310-cp310-linux_aarch64.whl && \
    pip3 install --no-cache-dir ./torch-2.5.0a0+872d972e41.nv24.08.17622132-cp310-cp310-linux_aarch64.whl && \
    rm -f /tmp/torch-2.5.0a0+872d972e41.nv24.08.17622132-cp310-cp310-linux_aarch64.whl

# Stage 5: Build torchvision from source for Jetson-compatible PyTorch
RUN cd /tmp && \
    git clone --branch v0.20.0 --depth 1 https://github.com/pytorch/vision.git && \
    cd vision && \
    BUILD_VERSION=0.20.0 \
    MAX_JOBS=2 \
    TORCH_CUDA_ARCH_LIST="${CUDA_ARCH}" \
    FORCE_CUDA=1 \
    pip3 install --no-cache-dir --no-build-isolation --no-deps -v . && \
    cd / && \
    rm -rf /tmp/vision

# Runtime dependency required by torchvision / detectron2.
# Pillow 10.x removes PIL.Image.LINEAR, so use the verified working version.
RUN pip3 install --no-cache-dir --no-deps pillow==9.5.0

# Verify torch / torchvision imports.
# NOTE: torch.cuda.is_available() may be False during docker build because the build
# step is not executed with NVIDIA runtime. Check CUDA again after docker run.
RUN python3 -c "import torch; print(torch.__version__); print('cuda_available_during_build=', torch.cuda.is_available())" && \
    python3 -c "import torchvision; print(torchvision.__version__)" && \
    python3 -c "from torchvision.ops import nms; print('torchvision nms OK')"

# Stage 6: Install FoundationPose / ROS2 Python dependencies.
# requirements-jetson-ros2.txt must not include torch / torchvision / ultralytics.
COPY docker/requirements-jetson-ros2.txt /tmp/requirements-jetson-ros2.txt
RUN pip3 install --no-cache-dir -r /tmp/requirements-jetson-ros2.txt && \
    rm /tmp/requirements-jetson-ros2.txt

# Install torch-dependent utilities without dependencies.
# This prevents pip from pulling generic PyPI torch / torchvision / CUDA packages.
RUN pip3 install --no-cache-dir --no-deps \
        kornia==0.7.3 \
        timm==1.0.24

# Upgrade typing_extensions
RUN pip3 install --no-cache-dir typing_extensions==4.13.2

# Stage 7: Build nvdiffrast v0.4.0 from source
# Patch metadata issue seen on Jetson before editable install.
RUN cd /opt && \
    git clone https://github.com/NVlabs/nvdiffrast.git && \
    cd nvdiffrast && \
    git checkout v0.4.0 && \
    sed -i "/from importlib.metadata import version/d" nvdiffrast/__init__.py && \
    sed -i "s|__version__ = version(__package__ or 'nvdiffrast')|__version__ = '0.4.0'|g" nvdiffrast/__init__.py && \
    TORCH_CUDA_ARCH_LIST="${CUDA_ARCH}" \
    FORCE_CUDA=1 \
    pip3 install --no-cache-dir --no-build-isolation --no-deps -e /opt/nvdiffrast

RUN python3 -c "import nvdiffrast.torch as dr; print('nvdiffrast OK')"

# Stage 8: Build PyTorch3D v0.7.7 from source
RUN TORCH_CUDA_ARCH_LIST="${CUDA_ARCH}" \
    FORCE_CUDA=1 \
    MAX_JOBS=2 \
    pip3 install --no-cache-dir --no-build-isolation --no-deps \
    "git+https://github.com/facebookresearch/pytorch3d.git@v0.7.7"

RUN python3 -c "from pytorch3d.transforms import so3_log_map; print('pytorch3d OK')"

# Stage 9: Build Detectron2 v0.6 from source
RUN TORCH_CUDA_ARCH_LIST="${CUDA_ARCH}" \
    FORCE_CUDA=1 \
    MAX_JOBS=2 \
    pip3 install --no-cache-dir --no-build-isolation --no-deps \
    "git+https://github.com/facebookresearch/detectron2.git@v0.6"

RUN python3 -c "import detectron2; print('detectron2 OK')" && \
    python3 -c "from detectron2.engine import DefaultPredictor; print('DefaultPredictor OK')"

# Stage 10: Install ROS 2 Humble + RealSense
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        software-properties-common curl gnupg lsb-release && \
    add-apt-repository universe && \
    curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key \
        -o /usr/share/keyrings/ros-archive-keyring.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] http://packages.ros.org/ros2/ubuntu $(lsb_release -cs) main" \
        > /etc/apt/sources.list.d/ros2.list && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        ros-humble-ros-base \
        ros-humble-tf2-ros \
        ros-humble-tf-transformations \
        ros-humble-geometry-msgs \
        ros-humble-sensor-msgs \
        ros-humble-std-msgs \
        ros-humble-cv-bridge \
        ros-humble-realsense2-camera \
        python3-rosdep \
        python3-colcon-common-extensions && \
    rm -rf /var/lib/apt/lists/*

# Source ROS on every bash session + preload TLS workaround libraries
RUN echo "source /opt/ros/humble/setup.bash" >> /etc/bash.bashrc && \
    echo 'export LD_PRELOAD="/lib/aarch64-linux-gnu/libGLdispatch.so.0 $(find /usr/local/lib -name "libgomp-*.so*" -path "*/scikit_learn*" 2>/dev/null | head -1)"' >> /etc/bash.bashrc

# Stage 11: Claude Code CLI
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y --no-install-recommends nodejs && \
    rm -rf /var/lib/apt/lists/* && \
    npm install -g @anthropic-ai/claude-code

WORKDIR /workspace

# Stage 12: YOLO inference packages
# Install without dependencies to avoid pulling generic PyPI torch / CUDA packages.
COPY yolo/requirements_yolo.txt /tmp/requirements_yolo.txt
RUN pip3 install --no-cache-dir --no-deps -r /tmp/requirements_yolo.txt && \
    rm /tmp/requirements_yolo.txt

# Remove pip-installed OpenCV packages to avoid Jetson/L4T cv2 conflicts
RUN python3 -m pip uninstall -y \
    opencv-python \
    opencv-python-headless \
    opencv-contrib-python \
    opencv-contrib-python-headless || true && \
    PY_SITE=$(python3 -c "import site; print(site.getsitepackages()[0])") && \
    rm -rf "$PY_SITE/cv2" && \
    rm -rf "$PY_SITE"/opencv_python* && \
    rm -rf "$PY_SITE"/opencv_contrib_python*

# EasyOCR without pulling pip OpenCV / torch again
RUN pip3 install --no-cache-dir --no-deps easyocr==1.7.2

# EasyOCR / YOLO runtime dependencies that do not need to pull torch
RUN pip3 install --no-cache-dir --no-deps \
    python-bidi \
    pyclipper \
    Shapely \
    py-cpuinfo \
    ultralytics-thop \
    seaborn

# Copy YOLO project into image
COPY yolo /workspace/yolo

# Default working directory for inference scripts
WORKDIR /workspace/yolo/src